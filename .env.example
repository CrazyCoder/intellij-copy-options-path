# Local secrets for signing and publishing. Copy to .env and fill in.
# .env is gitignored. Never commit real values.
#
# The build reads the environment first and this file second, so CI can set the
# same names as real environment variables and nothing else has to change.

# JetBrains Marketplace permanent token, from
# https://plugins.jetbrains.com/author/me/tokens
PUBLISH_TOKEN=

# Signing credentials. Leave these empty to use the local .signing/ files
# (chain.crt and private.pem), which is the usual setup on a developer machine.
CERTIFICATE_CHAIN=
PRIVATE_KEY=
PRIVATE_KEY_PASSWORD=
